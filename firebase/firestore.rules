rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Registrations: any authenticated user can read (needed for admin dashboard)
    match /registrations/{email} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Teams: any authenticated user can read, owner can write
    match /teams/{email} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.token.email.lower() == email;
      allow update: if request.auth != null && request.auth.token.email.lower() == email;
    }

    // Announcements: any authenticated can read, any authenticated can write (for admin)
    match /announcements/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
